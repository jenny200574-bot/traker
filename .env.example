# Copia este archivo a .env y completa los valores en el servidor.
# No pongas claves reales en el repositorio. No hay valores por defecto.

# Obligatoria. Sirve para firmar la sesión y cifrar las credenciales de Dropi.
DROP_SECRET_KEY=

# Carpeta de la base real, la de demostración y los respaldos.
DROP_DATA_DIR=data

# Escucha local. Otra interfaz exige además DROP_ALLOW_LAN=1.
DROP_HOST=127.0.0.1
DROP_PORT=8000
DROP_ALLOW_LAN=

# Zona de los horarios. America/Bogota si se deja vacío al crear la base.
DROP_TIMEZONE=America/Bogota

# Segundos entre vueltas del worker.
DROP_POLL_SECONDS=15
